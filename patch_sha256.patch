+static void check_sha_ni(void)
+{
+    if (sha_ni_checked) return;
+    unsigned int eax=0, ebx=0, ecx=0, edx=0;
+    if (__get_cpuid(7, &eax, &ebx, &ecx, &edx)) {
+        if (ebx & (1 << 29)) {
+            sha_ni_supported = true;
+        }
+    }
+    sha_ni_checked = true;
+}
