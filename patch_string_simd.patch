+static int cpu_has_avx512(void)
+{
+    if (!cpu_has_avx2()) return 0;
+    unsigned a, b, c, d;
+    __asm__ volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(7), "c"(0));
+    return (b & (1u << 16)) != 0;        /* leaf 7 EBX bit 16 = AVX512F      */
+}
