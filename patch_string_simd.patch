+__attribute__((target("avx512f")))
+static void *memcpy_avx512(void *dest, const void *src, size_t n)
+{
+    unsigned char *d = (unsigned char *)dest;
+    const unsigned char *s = (const unsigned char *)src;
+
+    while (n >= 128) {
+        __m512i v0 = _mm512_loadu_si512((const void *)(s + 0));
+        __m512i v1 = _mm512_loadu_si512((const void *)(s + 64));
+        _mm512_storeu_si512((void *)(d + 0), v0);
+        _mm512_storeu_si512((void *)(d + 64), v1);
+        d += 128;
+        s += 128;
+        n -= 128;
+    }
+    if (n >= 64) {
+        _mm512_storeu_si512((void *)d, _mm512_loadu_si512((const void *)s));
+        d += 64;
+        s += 64;
+        n -= 64;
+    }
+    if (n >= 32) {
+        _mm256_storeu_si256((__m256i *)d, _mm256_loadu_si256((const __m256i *)s));
+        d += 32;
+        s += 32;
+        n -= 32;
+    }
+    if (n >= 16) {
+        _mm_storeu_si128((__m128i *)d, _mm_loadu_si128((const __m128i *)s));
+        d += 16;
+        s += 16;
+        n -= 16;
+    }
+    while (n--) {
+        *d++ = *s++;
+    }
+    return dest;
+}
